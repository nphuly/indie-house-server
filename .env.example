APP_NAME="Indie House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PUBLIC_SCHEME=http
TRUSTED_PROXIES=null
SESSION_SECURE_COOKIE=false

# Instance identity (see docs/en/configuration.md).
# Generate INSTANCE_ID once as UUID v4; use the same canonical HTTPS origin in
# APP_URL, INSTANCE_BASE_URL and STREAM_JWT_ISSUER in production.
INSTANCE_ID=
INSTANCE_NAME="Indie House"
# Shown on /terms and /privacy for data requests and copyright complaints.
INSTANCE_CONTACT_EMAIL=
INSTANCE_BASE_URL=
INSTANCE_REGISTRATION_MODE=closed
INSTANCE_MINIMUM_MOBILE_VERSION=1.0.0
INSTANCE_MAX_USERS=100
INSTANCE_MAX_ACTIVE_INVITES=20

# Deployment VM only: lets plain `docker compose ...` use the production file
# and the stream profile, like infrastructure/scripts/deploy-release.sh.
# COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
# COMPOSE_PROFILES=stream

# Edge port on the deployment VM. Keep loopback-only when cloudflared runs on
# the same VM and proxies to http://127.0.0.1:8080.
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=indie_house
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the queue worker's --timeout=600 in docker-compose.yml.
REDIS_QUEUE_RETRY_AFTER=630

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Production requires one (deploy-release.sh refuses an empty value): Compose
# turns on requirepass and passes it to every client. Generate it with
# `openssl rand -hex 32`. Development leaves it empty.
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Laravel uses a full URL; the Go services use host:port without a scheme.
# For a private MinIO on the same VM, publish only its S3 API through a second
# Cloudflare Tunnel route (objects.example.com). Laravel signs browser
# uploads and artwork URLs, so AWS_ENDPOINT stays on that public hostname.
AWS_ENDPOINT=
# Laravel's own S3 calls (moves, existence checks, mobile artwork) go straight
# to this LAN URL, still signed for AWS_ENDPOINT, e.g. http://10.0.0.5:9000.
# Leave empty to send them to AWS_ENDPOINT.
AWS_INTERNAL_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
# The Go services read and write media here: use the LAN address (for example
# 10.0.0.5:9000 with SSL off) so audio does not loop out through Cloudflare.
MINIO_ENDPOINT=
MINIO_USE_SSL=false
# The gateway signs presigned URLs for this host, which clients must reach.
# Empty signs for MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=

# Backup archives are stored on the shared backup_data volume. To copy each
# completed archive offsite, set "Offsite disk" to s3 in Admin > Backup Settings.
# Every file in a backup is encrypted with AES-256 under this key. Production
# requires it; keep a copy outside the VM, or no backup can be restored.
# Generate it with `openssl rand -base64 32`.
BACKUP_ENCRYPTION_KEY=

# Stream gateway (mobile; do not commit real secrets)
# Generate one shared key with: openssl rand -hex 32
INTERNAL_API_KEY=
STREAM_JWT_ISSUER=
STREAM_JWT_AUDIENCE=indie-house-mobile
STREAM_JWT_PRIVATE_KEY_PATH=/app/storage/keys/private.key
STREAM_JWT_KEY_ID=stream-v1
STREAM_JWT_MANAGED_KEYS_DIRECTORY=/app/storage/keys
STREAM_JWT_ACCESS_TTL_MINUTES=15
STREAM_DEFAULT_HQ_ENABLED=true
STREAM_AUTH_RATE_LIMIT_STORE=redis
STREAM_REFRESH_TTL_DAYS=30
STREAM_MAX_SESSIONS_PER_USER=10
# Web and /legacy audio redirect to the gateway with a playback ticket
# (docker-compose.development.yml turns this off: it has no Caddy edge).
STREAM_WEB_AUDIO_VIA_GATEWAY=true
STREAM_PLAYBACK_TICKET_TTL_MINUTES=60
# Laravel publishes track changes; the gateway drops its cached lookups.
STREAM_CACHE_INVALIDATION=true
CATALOGUE_CACHE_TTL_SECONDS=300
MONITOR_BACKUP_MAX_AGE_HOURS=26
MONITOR_MIN_DISK_FREE_GB=10

VITE_APP_NAME="${APP_NAME}"
